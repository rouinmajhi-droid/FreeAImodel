# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_DATABASE_URL: Optional override for the Firebase Realtime Database URL.
FIREBASE_DATABASE_URL="https://aisdd-6f89e-default-rtdb.firebaseio.com"

# FIREBASE_DATABASE_SECRET: Optional Firebase Realtime Database legacy secret / auth token.
FIREBASE_DATABASE_SECRET=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional (recommended if RTDB rules restrict public read/write).
# Full Firebase Service Account JSON string allowing the Node.js gateway backend
# to mint OAuth tokens for Firebase Realtime Database on cold starts.
FIREBASE_SERVICE_ACCOUNT_JSON=""
