rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rouinmajhi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /user_profiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId &&
        incoming().uid == request.auth.uid &&
        incoming().email is string && incoming().email.size() <= 256 &&
        incoming().freeCreditsAllocated is number &&
        incoming().freeCreditsSpent is number &&
        (incoming().role == 'user' || (incoming().role == 'admin' && isAdmin()));
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        incoming().uid == existing().uid &&
        (isAdmin() || incoming().role == existing().role);
      allow delete: if isAdmin();
    }

    // User Gateway API Keys
    match /api_keys/{apiKeyId} {
      allow get: if isSignedIn() && isValidId(apiKeyId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(apiKeyId) &&
        incoming().userId == request.auth.uid &&
        incoming().key is string && incoming().key.size() <= 128 &&
        incoming().name is string && incoming().name.size() <= 128 &&
        incoming().status in ['active', 'revoked'];
      allow update: if isSignedIn() && isValidId(apiKeyId) &&
        (existing().userId == request.auth.uid || isAdmin()) &&
        incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(apiKeyId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // Master Key Pool for Providers (Admin only)
    match /provider_keys/{providerKeyId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(providerKeyId);
    }

    // Dynamic Discovered Models (All authenticated users can read, Admin can manage)
    match /models/{modelId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(modelId);
    }

    // Telemetry & Request logs
    match /request_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(logId) &&
        incoming().userId == request.auth.uid &&
        incoming().model is string && incoming().model.size() <= 128;
      allow update, delete: if isAdmin();
    }

    // Admins list
    match /admins/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
