{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-api-key" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-api-key" }
      ]
    },
    {
      "source": "/models",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-api-key" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/models",
      "missing": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/models",
      "has": [
        {
          "type": "header",
          "key": "authorization"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/models",
      "has": [
        {
          "type": "header",
          "key": "x-api-key"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/models",
      "has": [
        {
          "type": "query",
          "key": "key"
        }
      ],
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|v1/).*)",
      "destination": "/index.html"
    }
  ]
}
